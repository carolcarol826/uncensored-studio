{
  "_comment": "NOTE on the second LoRA: the base model is trained on safe data, so any instruction that forces it to repaint an explicit region — moving the hands away from the groin, for instance — came back with the anatomy erased or reduced to a stub, which broke the rule that anything the prompt did not mention must survive the edit. MCNL supplies the prior the base model lacks. Instruction-driven image editing on Qwen-Image-Edit 2511 — the same graph as qwen-edit-tryon with a single reference image. Chosen over SDXL img2img because SDXL reads prompts through CLIP, which understands no Chinese, and because sampling from a person's own latent is what keeps their face. Qwen2.5-VL reads the instruction, so the user can write in Chinese. Steps and CFG come from the Lightning LoRA and must not be overridden. Placeholders: __POSITIVE__, __INPUT_IMAGE__.",
  "1": {
    "inputs": { "unet_name": "qwen_image_edit_2511_fp8mixed.safetensors", "weight_dtype": "default" },
    "class_type": "UNETLoader",
    "_meta": { "title": "Qwen-Image-Edit 2511" }
  },
  "2": {
    "inputs": { "model": ["1", 0], "shift": 3.1 },
    "class_type": "ModelSamplingAuraFlow",
    "_meta": { "title": "Model sampling" }
  },
  "3": {
    "inputs": { "model": ["2", 0], "strength": 1.0 },
    "class_type": "CFGNorm",
    "_meta": { "title": "CFG norm" }
  },
  "4": {
    "inputs": {
      "model": ["3", 0],
      "lora_name": "Qwen-Image-Edit-2511-Lightning-4steps-V1.0-bf16.safetensors",
      "strength_model": 1.0
    },
    "class_type": "LoraLoaderModelOnly",
    "_meta": { "title": "Lightning 4-step LoRA" }
  },
  "41": {
    "inputs": {
      "model": ["4", 0],
      "lora_name": "qwen-edit-nsfw-mcnl-v1.safetensors",
      "strength_model": 1.0
    },
    "class_type": "LoraLoaderModelOnly",
    "_meta": { "title": "NSFW anatomy LoRA" }
  },
  "5": {
    "inputs": { "clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors", "type": "qwen_image", "device": "default" },
    "class_type": "CLIPLoader",
    "_meta": { "title": "Qwen2.5-VL" }
  },
  "6": {
    "inputs": { "vae_name": "qwen_image_vae.safetensors" },
    "class_type": "VAELoader",
    "_meta": { "title": "Qwen VAE" }
  },
  "10": {
    "inputs": { "image": "__INPUT_IMAGE__", "upload": "image" },
    "class_type": "LoadImage",
    "_meta": { "title": "Source" }
  },
  "12": {
    "inputs": { "image": ["10", 0] },
    "class_type": "FluxKontextImageScale",
    "_meta": { "title": "Fit to a supported size" }
  },
  "20": {
    "inputs": { "clip": ["5", 0], "prompt": "__POSITIVE__", "vae": ["6", 0], "image1": ["12", 0] },
    "class_type": "TextEncodeQwenImageEditPlus",
    "_meta": { "title": "Instruction" }
  },
  "21": {
    "inputs": { "clip": ["5", 0], "prompt": "", "vae": ["6", 0], "image1": ["12", 0] },
    "class_type": "TextEncodeQwenImageEditPlus",
    "_meta": { "title": "Negative" }
  },
  "22": {
    "inputs": { "conditioning": ["20", 0], "reference_latents_method": "index_timestep_zero" },
    "class_type": "FluxKontextMultiReferenceLatentMethod",
    "_meta": { "title": "Positive refs" }
  },
  "23": {
    "inputs": { "conditioning": ["21", 0], "reference_latents_method": "index_timestep_zero" },
    "class_type": "FluxKontextMultiReferenceLatentMethod",
    "_meta": { "title": "Negative refs" }
  },
  "30": {
    "inputs": { "pixels": ["12", 0], "vae": ["6", 0] },
    "class_type": "VAEEncode",
    "_meta": { "title": "Source latent" }
  },
  "40": {
    "inputs": {
      "seed": 0,
      "steps": 4,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1,
      "model": ["41", 0],
      "positive": ["22", 0],
      "negative": ["23", 0],
      "latent_image": ["30", 0]
    },
    "class_type": "KSampler",
    "_meta": { "title": "Sampler" }
  },
  "50": {
    "inputs": { "samples": ["40", 0], "vae": ["6", 0] },
    "class_type": "VAEDecode",
    "_meta": { "title": "Decode" }
  },
  "60": {
    "inputs": { "filename_prefix": "myhim-qwen-edit", "images": ["50", 0] },
    "class_type": "SaveImage",
    "_meta": { "title": "Save" }
  }
}

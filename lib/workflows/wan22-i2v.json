{
  "_comment": "Wan 2.2 TI2V-5B image-to-video on ComfyUI's native Wan nodes. Deliberately not kijai's WanVideoWrapper: that wrapper wants its own repackaged weights and rejects the Comfy-Org fp8-scaled T5 we host. Models live on the network volume under models/{unet,clip,vae} — the legacy folder names, which are the ones worker-comfyui's extra_model_paths maps and which ComfyUI aliases to diffusion_models/text_encoders. Placeholders: __CKPT__, __POSITIVE__, __NEGATIVE__, __INPUT_IMAGE__.",
  "1": {
    "inputs": { "unet_name": "__CKPT__", "weight_dtype": "default" },
    "class_type": "UNETLoader",
    "_meta": { "title": "Wan 2.2 diffusion model" }
  },
  "2": {
    "inputs": { "image": "__INPUT_IMAGE__", "upload": "image" },
    "class_type": "LoadImage",
    "_meta": { "title": "Load Image" }
  },
  "3": {
    "inputs": {
      "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "wan",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": { "title": "UMT5 text encoder" }
  },
  "9": {
    "inputs": { "vae_name": "wan2.2_vae.safetensors" },
    "class_type": "VAELoader",
    "_meta": { "title": "Wan 2.2 VAE" }
  },
  "4": {
    "inputs": { "text": "__POSITIVE__", "clip": ["3", 0] },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Positive" }
  },
  "10": {
    "inputs": { "text": "__NEGATIVE__", "clip": ["3", 0] },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Negative" }
  },
  "6": {
    "inputs": {
      "vae": ["9", 0],
      "width": 832,
      "height": 480,
      "length": 81,
      "batch_size": 1,
      "start_image": ["2", 0]
    },
    "class_type": "Wan22ImageToVideoLatent",
    "_meta": { "title": "I2V latent" }
  },
  "11": {
    "inputs": { "shift": 8.0, "model": ["1", 0] },
    "class_type": "ModelSamplingSD3",
    "_meta": { "title": "Sampling shift" }
  },
  "5": {
    "inputs": {
      "seed": 0,
      "steps": 20,
      "cfg": 5.0,
      "sampler_name": "uni_pc",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": ["11", 0],
      "positive": ["4", 0],
      "negative": ["10", 0],
      "latent_image": ["6", 0]
    },
    "class_type": "KSampler",
    "_meta": { "title": "Sampler" }
  },
  "7": {
    "inputs": { "samples": ["5", 0], "vae": ["9", 0] },
    "class_type": "VAEDecode",
    "_meta": { "title": "Decode" }
  },
  "8": {
    "inputs": {
      "images": ["7", 0],
      "frame_rate": 16,
      "loop_count": 0,
      "filename_prefix": "uncensored-studio/wan-i2v",
      "format": "video/h264-mp4",
      "pingpong": false,
      "save_output": true,
      "save_metadata": true,
      "crf": 19
    },
    "class_type": "VHS_VideoCombine",
    "_meta": { "title": "Save Video" }
  }
}

{
  "_comment": "Wan 2.2 I2V-A14B with the lightx2v 4-step distillation adapters. A14B samples through two experts in sequence, and the adapter ships one file per expert — node 15 feeds the high-noise branch, node 16 the low-noise one; attaching only one leaves half the denoise at full cost. Steps drop 20 to 4 and CFG to 1, which is what the distillation expects: at 20 steps a 10-second clip ran past the endpoint's 25-minute ceiling and was killed while still billing us. The split moves with the step count — high noise runs 0-2, low noise 2 to the end. Placeholders: __CKPT__ (ignored, the graph names its own weights), __POSITIVE__, __NEGATIVE__, __INPUT_IMAGE__.",
  "1": {
    "inputs": {
      "unet_name": "wan2.2_i2v_high_noise_14B_fp8_scaled.safetensors",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "High-noise expert"
    }
  },
  "2": {
    "inputs": {
      "unet_name": "wan2.2_i2v_low_noise_14B_fp8_scaled.safetensors",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Low-noise expert"
    }
  },
  "3": {
    "inputs": {
      "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "wan",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "UMT5 text encoder"
    }
  },
  "4": {
    "inputs": {
      "vae_name": "wan_2.1_vae.safetensors"
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "Wan 2.1 VAE"
    }
  },
  "5": {
    "inputs": {
      "image": "__INPUT_IMAGE__",
      "upload": "image"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "Start frame"
    }
  },
  "6": {
    "inputs": {
      "text": "__POSITIVE__",
      "clip": [
        "3",
        0
      ]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Positive"
    }
  },
  "7": {
    "inputs": {
      "text": "__NEGATIVE__",
      "clip": [
        "3",
        0
      ]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Negative"
    }
  },
  "8": {
    "inputs": {
      "positive": [
        "6",
        0
      ],
      "negative": [
        "7",
        0
      ],
      "vae": [
        "4",
        0
      ],
      "width": 832,
      "height": 480,
      "length": 81,
      "batch_size": 1,
      "start_image": [
        "5",
        0
      ]
    },
    "class_type": "WanImageToVideo",
    "_meta": {
      "title": "I2V conditioning"
    }
  },
  "9": {
    "inputs": {
      "shift": 8.0,
      "model": [
        "15",
        0
      ]
    },
    "class_type": "ModelSamplingSD3",
    "_meta": {
      "title": "Shift (high)"
    }
  },
  "10": {
    "inputs": {
      "shift": 8.0,
      "model": [
        "16",
        0
      ]
    },
    "class_type": "ModelSamplingSD3",
    "_meta": {
      "title": "Shift (low)"
    }
  },
  "11": {
    "inputs": {
      "add_noise": "enable",
      "noise_seed": 0,
      "steps": 4,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "start_at_step": 0,
      "end_at_step": 2,
      "return_with_leftover_noise": "enable",
      "model": [
        "9",
        0
      ],
      "positive": [
        "8",
        0
      ],
      "negative": [
        "8",
        1
      ],
      "latent_image": [
        "8",
        2
      ]
    },
    "class_type": "KSamplerAdvanced",
    "_meta": {
      "title": "Sample — high-noise expert"
    }
  },
  "12": {
    "inputs": {
      "add_noise": "disable",
      "noise_seed": 0,
      "steps": 4,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "start_at_step": 2,
      "end_at_step": 10000,
      "return_with_leftover_noise": "disable",
      "model": [
        "10",
        0
      ],
      "positive": [
        "8",
        0
      ],
      "negative": [
        "8",
        1
      ],
      "latent_image": [
        "11",
        0
      ]
    },
    "class_type": "KSamplerAdvanced",
    "_meta": {
      "title": "Sample — low-noise expert"

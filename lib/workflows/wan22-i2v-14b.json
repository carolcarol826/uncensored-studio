    }
  },
  "14": {
    "inputs": {
      "images": [
        "13",
        0
      ],
      "frame_rate": 16,
      "loop_count": 0,
      "filename_prefix": "uncensored-studio/wan-i2v-14b",
      "format": "video/h264-mp4",
      "pingpong": false,
      "save_output": true,
      "save_metadata": true,
      "crf": 19
    },
    "class_type": "VHS_VideoCombine",
    "_meta": {
      "title": "Save Video"
    }
  },
  "15": {
    "inputs": {
      "model": [
        "1",
        0
      ],
      "lora_name": "wan22-i2v-lightning-high.safetensors",
      "strength_model": 1.0
    },
    "class_type": "LoraLoaderModelOnly",
    "_meta": {
      "title": "Lightning 4-step (high noise)"
    }
  },
  "16": {
    "inputs": {
      "model": [
        "2",
        0
      ],
      "lora_name": "wan22-i2v-lightning-low.safetensors",
      "strength_model": 1.0
    },
    "class_type": "LoraLoaderModelOnly",

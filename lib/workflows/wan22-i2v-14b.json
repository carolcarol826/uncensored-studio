{
  "_comment": "Wan 2.2 I2V-A14B image-to-video. A14B is a mixture of experts: the high-noise expert runs the early steps and hands the leftover noise to the low-noise expert for the rest, which is why there are two UNETLoaders and two KSamplerAdvanced passes. Identity holds far better than the TI2V-5B, which drifted into a different face on real photos. Note this variant pairs with wan_2.1_vae — wan2.2_vae belongs to the 5B. WanImageToVideo centre-crops start_image to the requested frame, so width/height should follow the source's aspect. Placeholders: __CKPT__ (unused; experts are named below), __POSITIVE__, __NEGATIVE__, __INPUT_IMAGE__.",
  "1": {
    "inputs": { "unet_name": "wan2.2_i2v_high_noise_14B_fp8_scaled.safetensors", "weight_dtype": "default" },
    "class_type": "UNETLoader",
    "_meta": { "title": "High-noise expert" }
  },
  "2": {
    "inputs": { "unet_name": "wan2.2_i2v_low_noise_14B_fp8_scaled.safetensors", "weight_dtype": "default" },
    "class_type": "UNETLoader",
    "_meta": { "title": "Low-noise expert" }
  },
  "3": {
    "inputs": { "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan", "device": "default" },
    "class_type": "CLIPLoader",
    "_meta": { "title": "UMT5 text encoder" }
  },
  "4": {
    "inputs": { "vae_name": "wan_2.1_vae.safetensors" },
    "class_type": "VAELoader",
    "_meta": { "title": "Wan 2.1 VAE" }
  },
  "5": {
    "inputs": { "image": "__INPUT_IMAGE__", "upload": "image" },
    "class_type": "LoadImage",
    "_meta": { "title": "Start frame" }
  },
  "6": {
    "inputs": { "text": "__POSITIVE__", "clip": ["3", 0] },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Positive" }
  },
  "7": {
    "inputs": { "text": "__NEGATIVE__", "clip": ["3", 0] },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Negative" }
  },
  "8": {
    "inputs": {
      "positive": ["6", 0],
      "negative": ["7", 0],
      "vae": ["4", 0],
      "width": 832,
      "height": 480,
      "length": 81,
      "batch_size": 1,
      "start_image": ["5", 0]
    },
    "class_type": "WanImageToVideo",
    "_meta": { "title": "I2V conditioning" }
  },
  "9": {
    "inputs": { "shift": 8.0, "model": ["1", 0] },
    "class_type": "ModelSamplingSD3",
    "_meta": { "title": "Shift (high)" }
  },
  "10": {
    "inputs": { "shift": 8.0, "model": ["2", 0] },
    "class_type": "ModelSamplingSD3",
    "_meta": { "title": "Shift (low)" }
  },
  "11": {
    "inputs": {
      "add_noise": "enable",
      "noise_seed": 0,
      "steps": 20,
      "cfg": 3.5,
      "sampler_name": "euler",
      "scheduler": "simple",
      "start_at_step": 0,
      "end_at_step": 10,
      "return_with_leftover_noise": "enable",
      "model": ["9", 0],
      "positive": ["8", 0],
      "negative": ["8", 1],
      "latent_image": ["8", 2]
    },
    "class_type": "KSamplerAdvanced",
    "_meta": { "title": "Sample — high-noise expert" }
  },
  "12": {
    "inputs": {
      "add_noise": "disable",
      "noise_seed": 0,
      "steps": 20,
      "cfg": 3.5,
      "sampler_name": "euler",
      "scheduler": "simple",
      "start_at_step": 10,
      "end_at_step": 10000,
      "return_with_leftover_noise": "disable",
      "model": ["10", 0],
      "positive": ["8", 0],
      "negative": ["8", 1],
      "latent_image": ["11", 0]
    },
    "class_type": "KSamplerAdvanced",
    "_meta": { "title": "Sample — low-noise expert" }
  },
  "13": {
    "inputs": { "samples": ["12", 0], "vae": ["4", 0] },
    "class_type": "VAEDecode",
    "_meta": { "title": "Decode" }
  },
  "14": {
    "inputs": {
      "images": ["13", 0],
      "frame_rate": 16,
      "loop_count": 0,
      "filename_prefix": "uncensored-studio/wan-i2v-14b",
      "format": "video/h264-mp4",
      "pingpong": false,
      "save_output": true,
      "save_metadata": true,
      "crf": 19
    },
    "class_type": "VHS_VideoCombine",
    "_meta": { "title": "Save Video" }
  }
}
